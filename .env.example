# Copy to .env (git-ignored) and fill in ONLY if you want the optional real-LLM provider.
# The offline mock provider needs none of this.
# NOTE: the Claude chat subscription does NOT include API access; an API key is created
# separately in the Anthropic Console and is billed separately.
AUTOCOLLAB_PROVIDER=mock
ANTHROPIC_API_KEY=
AUTOCOLLAB_ANTHROPIC_MODEL=claude-sonnet-5-5
AUTOCOLLAB_ANTHROPIC_TIMEOUT_S=60
